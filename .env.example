# Telegram: https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_SESSION=my_account

# Spotify: https://developer.spotify.com/dashboard
# Этот же Redirect URI должен быть добавлен в настройках приложения (localhost Spotify больше не принимает)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Необязательно
POLL_INTERVAL=5
IDLE_TIMEOUT=60
BIO_TEMPLATE=🎧 {artist} — {title}
BIO_MAX_LEN=70          # 140 с Telegram Premium
MIN_LISTEN=5            # сколько секунд трек должен играть, чтобы попасть в профиль
MAX_UPDATES=5           # столько смен текста/эмодзи/цвета можно подряд...
UPDATE_REFILL=20        # ...дальше по одной раз в столько секунд
PHOTO_MIN_LISTEN=30     # когда листаешь треки — обложку ставим только тому, что играет столько секунд
PHOTO_DAILY_LIMIT=60    # максимум аватарок в сутки (Telegram блокирует на часы примерно после 85)

# Только с Telegram Premium
EMOJI_STATUS=1          # 🎧 в эмодзи-статусе, пока играет трек (сам исчезает в конце трека)
# EMOJI_STATUS_ID=      # id своего кастомного эмодзи вместо 🎧
AUTO_EMOJI=1            # подбирать эмодзи-статус: слова в названии → жанр → цвет обложки
PROFILE_COLOR=1         # красить профиль в цвет обложки
